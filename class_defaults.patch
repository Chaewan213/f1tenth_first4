+def waypoint_plan(wps: Optional[List[Tuple[float, float]]], conf: float,
+                  origin_offset_x: float = 0.0):
+    """학습 모델의 waypoint(1개 또는 수업 라벨처럼 7개)를 경로로 바꾼다.
+
+    origin_offset_x: 모델 라벨 원점(수업: 카메라 바로 아래 지면)이 뒷바퀴 축(base_link)보다
+    앞에 있는 거리 [m]. 이 값을 x에 더해 base_link 기준으로 맞춘다.
+    점은 차량에서 가까운 순으로 정렬한다. 점이 1개면 tracker는 그 점을 그대로 추종한다.
+    """
+    if not wps:
         return [], 0.0
-    return [(float(wp_xy[0]), float(wp_xy[1]))], conf
+    pts = [(float(x) + origin_offset_x, float(y)) for x, y in wps]
+    pts.sort(key=lambda q: q[0] * q[0] + q[1] * q[1])
+    return pts, conf
