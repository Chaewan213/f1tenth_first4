+# ROS Bayer 인코딩 -> OpenCV 변환 코드.
+# OpenCV는 패턴의 2번째 행 기준으로 이름을 붙이므로 bayer_rggb8 -> COLOR_BayerBG2BGR (수업 IRCV 3주차).
+# 잘못 고르면 R/B가 바뀌어 노란 차선이 하늘색으로 보인다.
+BAYER_TO_BGR = {
+    'bayer_rggb8': cv2.COLOR_BayerBG2BGR,
+    'bayer_bggr8': cv2.COLOR_BayerRG2BGR,
+    'bayer_gbrg8': cv2.COLOR_BayerGR2BGR,
+    'bayer_grbg8': cv2.COLOR_BayerGB2BGR,
+}
+
+
+def bayer_to_bgr(raw: np.ndarray, encoding: str) -> np.ndarray:
+    code = BAYER_TO_BGR.get(encoding)
+    if code is None:
+        raise ValueError(f'지원하지 않는 Bayer 인코딩: {encoding}')
+    return cv2.cvtColor(raw, code)
+
+
+def undistort_maps(p: 'LaneParams', width: int, height: int):
+    """왜곡 보정 remap 테이블. camera_matrix가 비어 있으면 None (보정 생략)."""
+    if not any(abs(v) > 1e-12 for v in p.camera_matrix):
+        return None
+    K = np.asarray(p.camera_matrix, np.float64).reshape(3, 3)
+    D = np.asarray(p.dist_coeffs, np.float64).reshape(-1)
+    return cv2.initUndistortRectifyMap(K, D, None, K, (width, height), cv2.CV_16SC2)
 
 
